<?php
    $translate = $this->plugin('translate');
    $escapeAttr = $this->plugin('escapeHtmlAttr');
    $hyperlink = $this->plugin('hyperlink');

    $mappedResourceName = [
            'items' => 'item',
            'item_sets' => 'item-set',
            'media' => 'media',
    ];
    $mappedTitle = [
        'item' => 'Items',
        'item-set' => 'Item sets',
        'media' => 'Medias',
    ];

    $results = []; 

    foreach ($resources as $resource) {
        $type = $mappedResourceName[$resource->getResourceName()];

        $title = $resource->getTitle();
        $id = $resource->getId();

        $output =  $hyperlink($title . '(' . $id . ')', $this->url('admin/default', ['controller' => $type, 'action' => 'browse'], ['query' => ['id' => $id]]));
        $results[$type][] = $output;
    }

    foreach ($results as $ttype => $values){
        echo '<div class="value">' . $mappedTitle[$ttype] . '</div>'; 
        echo '<div class="value">';

        foreach ($values as $value) {
            echo $value . '<br>';
        }
        echo '</div>';
    }
?>
